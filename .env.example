# docker compose 用の設定。このファイルを .env にコピーして書き換えてください。
# イベント名・案内文・参加登録キー・発表種別は、管理画面の「設定」タブで変更します。

# 管理画面 / タイムテーブル作成ツールのパスワード（必須）
# 平文ではなくハッシュ値を書きます。次のコマンドで作った1行をそのまま貼り付けてください。
#   make password
ADMIN_PASSWORD_HASH=

# 公開ポート（ホスト側）
HOST_PORT=8080

# 待ち受けアドレス（ホスト側）。下の HTTPS で公開する場合は 127.0.0.1 にして、
# 平文の HOST_PORT をインターネットに出さないでください。
HOST_BIND=0.0.0.0

# HTTPS で公開する場合は 1（Cookie に Secure を付ける）
COOKIE_SECURE=0

# ログインの有効時間（時間）
SESSION_HOURS=12

# 管理画面の編集権が、編集中の画面から連絡が来なくなってから自動で解放されるまでの秒数。
# タブを閉じたまま戻ってこない人がいても、これだけ待てば他の人が編集できます（最短30秒）。
EDIT_LEASE_SECONDS=120

# リバースプロキシ配下で X-Forwarded-For を信頼する場合は 1
TRUST_PROXY=0

# ---- HTTPS で公開する場合（make up-https）------------------------------------
# Let's Encrypt でサーバ証明書を自動取得・自動更新します。次の2つが前提です。
#   - 80/443 番がインターネットから到達できる
#   - SITE_ADDRESS の DNS（A / AAAA レコード）がこのホストを向いている
#
# 書き換えるのは次の5項目です（行を足さず、= の右側を書き換えてください）。
#   SITE_ADDRESS   … 証明書を取得するドメイン名（すぐ下）
#   ACME_EMAIL     … Let's Encrypt に登録するメールアドレス（すぐ下）
#   COOKIE_SECURE=1    … 上にあります
#   TRUST_PROXY=1      … 上にあります
#   HOST_BIND=127.0.0.1 … 上にあります

# 証明書を取得するドメイン名（例: program.example.ac.jp）
SITE_ADDRESS=

# Let's Encrypt のアカウントに登録するメールアドレス
ACME_EMAIL=

# 動作確認中はステージング環境を使うと発行回数の制限に掛かりません
# （ブラウザには証明書の警告が出ます）。本番に切り替えるときはコメントに戻して、
# `docker volume rm program-maker_caddy-data` でテスト用の証明書を捨ててください。
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# ---- オレオレ証明書で HTTPS にする場合（make up-https-selfsigned）-------------
# 公開できるドメイン名が無い、80番が外から塞がれている、学内 LAN だけで使う、といった
# 場合はこちら。Caddy が自前の CA で証明書を発行するので DNS も 80番の開放も要りません。
# ACME_EMAIL / ACME_CA は使いません。
#
# 書き換えるのは次の4項目です。
#   SITE_ADDRESS       … 上にあります。ブラウザで実際に使うホスト名と IP アドレスを
#                        すべてカンマ区切りで書きます（ここに無い名前で繋ぐと接続できません）。
#                          SITE_ADDRESS=program.example.local, 192.168.1.10, localhost
#   COOKIE_SECURE=1    … 上にあります
#   TRUST_PROXY=1      … 上にあります
#   HOST_BIND=127.0.0.1 … 上にあります
#
# 起動したら `make ca-cert` で CA の証明書を取り出せます。見る側の端末に入れておくと
# 証明書の警告が出なくなります（入れない場合は警告を承諾すれば使えます）。

# IP アドレスで繋がれたとき（ブラウザが接続先の名前を送ってこない）に返す証明書。
# 空なら make up-https-selfsigned が SITE_ADDRESS の先頭を使うので、普通は空のままで構いません。
DEFAULT_SNI=

# 使うリバースプロキシの設定ファイル。make up-https / make up-https-selfsigned が
# それぞれ渡すので、普通は空のままで構いません（docker compose を直に叩く場合だけ指定します）。
#CADDYFILE=./Caddyfile.selfsigned
