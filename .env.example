# docker compose 用の設定。このファイルを .env にコピーして書き換えてください。

# 管理画面 / タイムテーブル作成ツールのパスワード（必須）
ADMIN_PASSWORD=change-me

# 参加登録キーの初期値（初回起動時のみ反映。以後は管理画面の「設定」で変更）
REGISTRATION_KEY=

# イベント名の初期値（初回起動時のみ）
EVENT_NAME=研究発表会

# 公開ポート（ホスト側）
HOST_PORT=8080

# HTTPS で公開する場合は 1（Cookie に Secure を付ける）
COOKIE_SECURE=0

# ログインの有効時間（時間）
SESSION_HOURS=12

# リバースプロキシ配下で X-Forwarded-For を信頼する場合は 1
TRUST_PROXY=0
