# docker compose 用の設定。このファイルを .env にコピーして書き換えてください。
# イベント名・案内文・参加登録キー・発表種別は、管理画面の「設定」タブで変更します。

# 管理画面 / タイムテーブル作成ツールのパスワード（必須）
# 平文ではなくハッシュ値を書きます。次のコマンドで作った1行をそのまま貼り付けてください。
#   make password
ADMIN_PASSWORD_HASH=

# 公開ポート（ホスト側）
HOST_PORT=8080

# 待ち受けアドレス（ホスト側）。下の HTTPS で公開する場合は 127.0.0.1 にして、
# 平文の HOST_PORT をインターネットに出さないでください。
HOST_BIND=0.0.0.0

# HTTPS で公開する場合は 1（Cookie に Secure を付ける）
COOKIE_SECURE=0

# ログインの有効時間（時間）
SESSION_HOURS=12

# リバースプロキシ配下で X-Forwarded-For を信頼する場合は 1
TRUST_PROXY=0

# ---- HTTPS で公開する場合（make up-https）------------------------------------
# Let's Encrypt でサーバ証明書を自動取得・自動更新します。次の2つが前提です。
#   - 80/443 番がインターネットから到達できる
#   - SITE_ADDRESS の DNS（A / AAAA レコード）がこのホストを向いている
# 併せて上の COOKIE_SECURE=1 / TRUST_PROXY=1 / HOST_BIND=127.0.0.1 にしてください。

# 証明書を取得するドメイン名（例: program.example.ac.jp）
SITE_ADDRESS=

# Let's Encrypt のアカウントに登録するメールアドレス
ACME_EMAIL=

# 動作確認中はステージング環境を使うと発行回数の制限に掛かりません
# （ブラウザには証明書の警告が出ます）。本番に切り替えるときはコメントに戻して、
# `docker volume rm program-maker_caddy-data` でテスト用の証明書を捨ててください。
#ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
